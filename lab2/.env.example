# Скопируйте в .env и задайте свои значения:  cp .env.example .env
# Сам .env в git не коммитится (см. .gitignore)

# PostgreSQL
POSTGRES_DB=lab2
POSTGRES_USER=lab2
POSTGRES_PASSWORD=change_me

# Образ приложения (используется docker-compose.yml и scripts/build-and-push.sh)
# Для Docker Hub: docker.io/<ваш_логин>/lab2-app
APP_IMAGE=docker.io/your-dockerhub-login/lab2-app
APP_TAG=1.0.0

# Порт nginx на хосте
NGINX_PORT=80
